# Αντέγραψε σε .env και συμπλήρωσε. Το .env ΔΕΝ μπαίνει ποτέ στο git.

# Δημόσιο URL της εφαρμογής (για τα links/κουμπιά των ειδοποιήσεων)
APP_BASE_URL=https://study.example.com
# Δημόσιο URL του ntfy (σε αυτό συνδέεται το κινητό)
NTFY_PUBLIC_URL=https://ntfy.example.com

# Τυχαίο secret >= 32 χαρακτήρες:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Login dashboard. Hash με:  docker compose run --rm --no-deps app python -m app.hashpw
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=''

# Token του ntfy για αποστολή (ntfy token add studyapp). Μπορεί να οριστεί και από το dashboard.
NTFY_TOKEN=
NTFY_TOPIC=study

# Όριο μεγέθους ανά αρχείο (MB)
MAX_UPLOAD_MB=50
DEFAULT_TZ=Europe/Athens
# true πίσω από HTTPS. false μόνο για τοπική δοκιμή σε http://localhost
COOKIE_SECURE=true
# Όνομα του docker network του Nginx Proxy Manager
PROXY_NETWORK=npm_proxy

# Πόσοι reverse proxies προσθέτουν IP στο X-Forwarded-For (1 = μόνο NPM, 2 = Cloudflare + NPM).
TRUSTED_PROXY_HOPS=1
